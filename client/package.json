{
  "name": "grafeno-client",
  "version": "0.2.0",
  "description": "A copy of the Grafeno engine's TypeScript client (grafeno/clients/typescript), kept here until it is published",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "private": true
}
