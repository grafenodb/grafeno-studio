{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grafeno Desktop",
  "mainBinaryName": "grafeno-desktop",
  "version": "0.2.0",
  "identifier": "dev.grafeno.desktop",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../studio"
    },
    "frontendDist": "../studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grafeno",
        "width": 1380,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#f4f7f5",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A graph engine for agent memory and knowledge",
    "longDescription": "Grafeno Desktop is the graphical interface of Grafeno, the graph engine for agent memory and knowledge. It opens database files with the Grafeno engine installed on the computer, and connects to Grafeno servers and clusters, through their HTTP API.",
    "publisher": "GrafenoDB",
    "copyright": "2026, Seerendo",
    "homepage": "https://github.com/grafenodb/grafeno-studio",
    "fileAssociations": [
      {
        "ext": [
          "redb"
        ],
        "name": "Grafeno database",
        "description": "Grafeno database",
        "role": "Editor",
        "mimeType": "application/x-grafeno-database"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "section": "database"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
